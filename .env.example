# Real mode is the safe default. Explicitly opt into development fixtures.
WEAVE_GRAPH_MODE=falkordb
WEAVE_GRAPH_NAME=novapay
# Teammate module factory: accepts Settings, returns a GraphGateway.
WEAVE_GRAPH_FACTORY=app.antony:create_gateway
# Alen's persisted retrieval uses the same WEAVE_* graph settings as the trace.
WEAVE_SOURCE_BACKEND=weave_data
WEAVE_FALKORDB_HOST=localhost
WEAVE_FALKORDB_PORT=6379
WEAVE_FALKORDB_USERNAME=
WEAVE_FALKORDB_PASSWORD=
WEAVE_FALKORDB_SSL=false
WEAVE_LLM_PROVIDER=none
WEAVE_OLLAMA_URL=http://localhost:11434
WEAVE_OLLAMA_MODEL=qwen2.5:7b
WEAVE_LLM_TIMEOUT_SECONDS=30
# Optional hosted synthesis; none remains the default. Never put this key in VITE_*.
# WEAVE_LLM_PROVIDER=openrouter
WEAVE_OPENROUTER_API_KEY=
WEAVE_LLM_MODEL=openai/gpt-oss-120b
WEAVE_OPENROUTER_MAX_TOKENS=1200
# OPENROUTER_API_KEY and LLM_MODEL are also supported aliases.
WEAVE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=novapay
FALKORDB_GRAPH=novapay
